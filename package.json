{
  "name": "breaking-the-barrier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build",
    "assets:acquire": "node scripts/acquire-ipadic.mjs",
    "assets:verify": "node scripts/verify-ipadic.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run build && playwright test",
    "build:extension": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "npm run build:extension && npm run build:content",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify": "npm run assets:verify && npm run typecheck && npm run lint && npm run test && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "lindera-wasm-bundler": "5.3.0",
    "wanakana": "5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.2.7",
    "@types/node": "26.2.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
